# ==========================================
# LARAVEL EPI MANAGEMENT - ENVIRONMENT CONFIG
# ==========================================

# =====================================
# Project Configuration
# =====================================
COMPOSE_PROJECT_NAME=laravel-epi

# =====================================
# Application Settings
# =====================================
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGEME
APP_URL=http://localhost:8080

# =====================================
# Database Configuration
# =====================================
DB_DATABASE=laravel_epi
DB_USERNAME=laravel
DB_PASSWORD=secret_password_here
DB_ROOT_PASSWORD=root_secret_password_here
DB_EXTERNAL_PORT=3306

# =====================================
# Application Ports
# =====================================
APP_PORT=8080
NGINX_PORT=80
NGINX_SSL_PORT=443

# =====================================
# Data Storage Path
# =====================================
DATA_PATH=./docker/data

# =====================================
# Network Configuration  
# =====================================
NETWORK_SUBNET=172.20.0.0/16

# =====================================
# Initialization Control
# =====================================
# Run database migrations on startup
RUN_MIGRATIONS=true

# Run database seeders on startup
RUN_SEEDERS=false

# Specific seeder class to run (leave empty for all)
SEEDER_CLASS=DatabaseSeeder

# Force fresh migration (WARNING: destroys existing data)
FORCE_SEED=false

# =====================================
# Performance Optimization
# =====================================
# Optimize application caches
OPTIMIZE_APP=true

# Clear caches on startup
CLEAR_CACHE=true

# Create storage symbolic link
STORAGE_LINK=true

# =====================================
# Cache Configuration
# =====================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# =====================================
# Redis Configuration
# =====================================
REDIS_PASSWORD=null

# =====================================
# Queue Workers (0 to disable)
# =====================================
QUEUE_WORKERS=0

# =====================================
# Development Overrides
# Uncomment for development environment
# =====================================
#APP_ENV=local
#APP_DEBUG=true
#RUN_SEEDERS=true
#FORCE_SEED=true
#CACHE_DRIVER=file
#SESSION_DRIVER=file
#QUEUE_CONNECTION=sync